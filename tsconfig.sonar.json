{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "paths": { "src/*": ["./src/*"] },
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "config/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "reports",
    "coverage",
    "test",
    "**/generated/**",
    "**/__generated__/**",
    "**/*.generated.ts",
    "**/*.generated.js"
  ]
}
