{
  "name": "FWCloud-Updater",
  "version": "2.0.5",
  "description": "FWCloud updater process",
  "author": "SOLTECSIS (https://soltecsis.com)",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soltecsis/fwcloud-updater.git"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "nest build",
    "format": "prettier --check \"{src,app,lib,test,config}/**/*.ts\"",
    "format:check": "npm run format && npm run format:ci",
    "format:ci": "prettier --check \"scripts/**/*.cjs\"",
    "format:fix": "prettier --write \"{src,app,lib,test,config}/**/*.ts\" \"scripts/**/*.cjs\"",
    "start": "npm run stop; npm run start:prod",
    "start:dev": "nest start",
    "start:watch": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "start:bg": "npm start &",
    "stop": "if [ -f \".pid\" ]; then PID=$(cat .pid); EXISTS=`ps axw | awk '{print $1}' | grep \"^${PID}$\"`; if [ \"$EXISTS\" ]; then kill $PID; fi; fi",
    "lint": "eslint \"{src,app,lib,test,config}/**/*.ts\"",
    "lint:check": "npm run lint && npm run lint:ci",
    "lint:ci": "eslint --config scripts/eslint.config.cjs \"scripts/**/*.cjs\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "pretest:ci": "node scripts/prepare-ci-reports.cjs",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit --json --outputFile=reports/tests/results.json",
    "test:coverage:ci": "npm run test:ci -- --coverage --coverageReporters=lcov --coverageReporters=json-summary --coverageReporters=html --coverageReporters=text-summary",
    "ci:reports": "node scripts/ci-reports.cjs",
    "test:ci-tools": "node --test scripts/*.test.cjs",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "update": "npm run stop && git checkout -- package-lock.json && git pull && npm install && git checkout -- package-lock.json && npm run build",
    "update-cert": "bin/update-cert.sh updater",
    "fresh_build_start": "clear && rm -rf node_modules package-lock.json && npm i && npm run build && npm run start"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "axios": "1.21.0",
    "child-process-promise": "2.2.1",
    "cookie-parser": "1.4.7",
    "semver-compare": "1.0.0",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.4.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "prettier": "3.8.2",
    "saxes": "6.0.0",
    "ts-jest": "29.4.9",
    "typescript": "6.0.2"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "cross-spawn": "7.0.6",
    "deepmerge": "4.1.1",
    "fast-uri": "4.2.3",
    "follow-redirects": "1.16.2",
    "glob": "14.0.3",
    "handlebars": "4.7.10",
    "js-yaml": "5.5.0",
    "lodash": "4.18.1",
    "minimatch": "11.0.4",
    "multer": "2.5.0",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/config",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(e2e-)?spec\\.ts$",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/src/$1"
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/test/DATA/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,js}",
      "config/**/*.ts",
      "!**/*.d.ts",
      "!**/*.{spec,test}.{ts,js}"
    ],
    "coverageDirectory": "reports/coverage",
    "testEnvironment": "node"
  },
  "jest-junit": {
    "outputDirectory": "reports/tests",
    "outputName": "junit.xml",
    "reportTestSuiteErrors": "true"
  }
}
